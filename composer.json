{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "abdiaziizaweis/accounting",
    "description": "Reusable double-entry accounting module for Laravel applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Abdiaziiz Aweis Bashiir",
            "email": "cabdicaziiz1717@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Abdiaziizaweis\\Accounting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Abdiaziizaweis\\Accounting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abdiaziizaweis\\Accounting\\AccountingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}